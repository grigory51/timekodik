{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["segments", "glossaryCandidates"],
  "properties": {
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "glossaryCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heard", "suggested", "preferred", "segmentIds", "context"],
        "properties": {
          "heard": { "type": "string", "minLength": 1 },
          "suggested": { "type": "string", "minLength": 1 },
          "preferred": { "type": "null" },
          "segmentIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "context": { "type": "string" }
        }
      }
    }
  }
}
